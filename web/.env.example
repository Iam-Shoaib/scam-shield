# EVM private key (0x-prefixed) for the wallet that pays Telegraph miners via x402.
# Must hold USDC on Base Sepolia (0x036CbD53842c5426634e7929541eC2318f3dCF7e).
# Server-only — never exposed to the client.
EVM_PRIVATE_KEY=0x...

# Telegraph node base URL.
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# Telegraph public explorer, used for the "verify this signal" links in the UI.
NEXT_PUBLIC_TELEGRAPH_EXPLORER_URL=https://explorer.telegraphprotocol.com

# MongoDB connection string. Local dev: local MongoDB server. Production: MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/scam-shield

# Safety-net ceiling (USD) on entity-driven miner spend per single scan.
# Message-level core checks always run regardless of this ceiling.
SCAN_SPEND_CEILING_USD=5.00
